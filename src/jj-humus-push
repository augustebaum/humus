#!/bin/sh
# Push with jj, then refresh the revision history comment on the PR.
# Run through a jj alias so pushes keep the comment current without making the
# bare `humus` command do anything on its own.
set -eu

jj git push "$@"
branch=$(jj bookmark list -r @ -T name 2>/dev/null | head -1 || true)
if [ -z "$branch" ]; then
    echo "jj-humus-push: working-copy commit has no bookmark; skipping humus" >&2
    exit 0
fi
if command -v humus >/dev/null 2>&1; then
    humus --branch "$branch"
else
    echo "jj-humus-push: humus not on PATH; skipping" >&2
fi